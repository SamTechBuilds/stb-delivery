# ── Token-based delivery (existing) ──
# Full URL of the STB Core delivery-api Edge Function
VITE_DELIVERY_API_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/delivery-api

# ── Slug-based public delivery (Phase 3) ──
# Base URL of the STB Core Supabase project (without trailing slash)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ── Shared ──
# The STB Core anon/publishable key, sent as the `apikey` header (it grants nothing on its own)
VITE_SUPABASE_ANON_KEY=

# Shown on error screens when no delivery data is available
VITE_STB_CONTACT_EMAIL=
VITE_STB_WEBSITE=https://samtechbuilds.netlify.app

# ── Delivery site URL (used for generating share links) ──
VITE_DELIVERY_SITE_URL=https://stb-delivery.vercel.app

# ── STB App URL ──
VITE_APP_WEB_URL=https://stb-webapp.vercel.app
